---
import "../styles/normalize.css";
import "../styles/webflow.css";
import "../styles/qh-limexhoney-0558b9c78e0aec338a0fcfad4.webflow.css";

import { asHTML, asText } from "@prismicio/helpers";
import { client } from "../lib/prismic";
import projectsData from "../data/projects.json";

const homepage = await client.getSingle("homepage");
const homepageFields = homepage?.data ?? {};
const projects = projectsData.projects;

const escapeHTML = (value: string): string =>
  String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");

const prismicText = (
  field: Parameters<typeof asText>[0] | string,
  fallback: string
): string => {
  if (typeof field === "string") return field.trim() || fallback;
  return asText(field)?.trim() || fallback;
};

const prismicHTML = (
  field: Parameters<typeof asHTML>[0] | string,
  fallback: string
): string => {
  if (typeof field !== "string" && asText(field)?.trim()) return asHTML(field) ?? "";

  const value = typeof field === "string" ? field.trim() || fallback : fallback;
  return `<p>${escapeHTML(value).replace(/\r?\n/g, "<br />")}</p>`;
};

const prismicURL = (
  field: string | { url?: string } | null | undefined,
  fallback: string
): string =>
  (typeof field === "string" ? field : field?.url) || fallback;
