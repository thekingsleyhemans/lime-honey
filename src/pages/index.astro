      $(document).scroll(function () {
        var position = ($(document).scrollTop() / $(document).height()) * 100;
        if (Math.ceil(position) > 0) {
          $(".circle.outline.title.light").css("border-color", "#de3b25");
        } else {
          $(".circle.outline.title.light").css("border-color", "#de3b25");
