              <div class="menu-bar top dark"></div>
              <div class="menu-bar bottom dark"></div>
            </a>

          </div>

        </div>
      </div>
    </div>


    <!-- FULL MENU -->
    <div class="menu-wrapper full light">

      <div class="menu-content dark">

        <div class="menu-fulls">

          <div class="container">

            <div class="menu-wrapper dark">

              <a
                href="/"
                class="brand nav dark w-inline-block"
              ></a>

            </div>

          </div>

        </div>

        <div class="container">

          <div class="flex-container left">

            <div class="div-block-59">

              <h1 class="heading h1 menu-link light">
                <a
                  href="/services"
                  class="menu-link dark"
                >
                  skillset
                </a>
              </h1>

              <h1 class="heading h1 menu-link dark">
                <a
                  href="/projects"
                  class="menu-link dark"
                >
                  juice
                </a>
              </h1>

              <h1 class="heading h1 menu-link dark">
                <a
                  href="/about"
                  class="menu-link dark"
                >
                  honeys
                </a>
              </h1>

              <h1 class="heading h1 menu-link dark">
                <a
                  href="/contact"
                  class="menu-link dark"
                >
                  contact
                </a>
              </h1>

              <h1 class="heading h1 menu-link dark">
                <a
                  href="/store"
                  class="menu-link dark"
                >
                  store
                </a>
              </h1>

            </div>

          </div>

        </div>

        <div class="full-nav-img dark"></div>

      </div>

    </div>


    <!-- PROJECT DETAILS -->
    <div class="section-10">

      <div class="container">

        <div class="flex-container wrap">

          <div class="div-block-51">

            <div class="div-block-52">

              <h1 class="heading h1 title dark">
                {project.title}
              </h1>

              <p class="p description project dark">
                {project.description}
              </p>

              <!-- PROJECT CATEGORY -->
              <div class="subtext h6 project-label dark">
                {project.category}
              </div>

            </div>


            <!-- PROJECT MEDIA -->
            <div class="portfolio-img-wrapper">

              {
                (project.media ?? []).map((media) => {

                  /* IMAGE / GIF */

                  if (
                    media.type === "image" ||
                    media.type === "gif"
                  ) {
                    return (
                      <img
                        src={media.src}
                        alt={project.title}
                        loading="lazy"
                      />
                    );
                  }


                  /* SELF-HOSTED VIDEO */

                  if (media.type === "video") {
                    return (
                      <video
                        src={media.src}
                        autoplay
                        muted
                        loop
                        playsinline
                        controls
                      />
                    );
                  }


                  /* YOUTUBE */

                  if (media.type === "youtube") {
                    return (
                      <iframe
                        src={media.src}
                        title={`${project.title} — YouTube video`}
                        frameborder="0"
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                      ></iframe>
                    );
                  }


                  /* VIMEO */

                  if (media.type === "vimeo") {
                    return (
                      <iframe
                        src={media.src}
                        title={`${project.title} — Vimeo video`}
                        frameborder="0"
                        loading="lazy"
                        allow="autoplay; fullscreen; picture-in-picture"
                        allowfullscreen
                      ></iframe>
                    );
                  }


                  return null;
                })
              }

            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- RELATED PROJECTS -->
    <div class="section-11">

      <div class="container">

        <div class="flex-container left">

