import "../styles/qh-limexhoney-0558b9c78e0aec338a0fcfad4.webflow.css";

import { client } from "../lib/prismic";

const about = await client.getSingle("about");

/*
 * ------------------------------------------------------------
 * Rich Text helpers
 * ------------------------------------------------------------
 *
 * Prismic Rich Text fields return an array of blocks.
 * We render them manually so we don't depend on
 * @prismicio/helpers or @prismicio/astro.
 */

const escapeHTML = (value) => {
  if (value === null || value === undefined) return "";

  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
};


/*
 * Render text with Prismic spans.
 *
 * This handles things like:
 *
 * Bold
 * Italic
 * Underline
 * Hyperlinks
 *
 * while keeping the content safe.
 */
const renderText = (block) => {
  if (!block) return "";

  let text = escapeHTML(block.text || "");

  if (!block.spans || !Array.isArray(block.spans)) {
    return text;
  }

  /*
   * Apply spans from right to left so the indexes
   * don't change while wrapping the text.
   */
  const spans = [...block.spans].sort((a, b) => b.start - a.start);

  spans.forEach((span) => {
    const start = span.start;
    const end = span.end;

    const before = text.substring(0, start);
    const content = text.substring(start, end);
    const after = text.substring(end);

    switch (span.type) {
      case "strong":
        text = `${before}<strong>${content}</strong>${after}`;
        break;

      case "em":
        text = `${before}<em>${content}</em>${after}`;
        break;

      case "hyperlink":
        if (span.data?.url) {
          const url = escapeHTML(span.data.url);

          text = `${before}<a href="${url}" target="_blank" rel="noopener noreferrer">${content}</a>${after}`;
        }
        break;

      case "label":
        if (span.data?.label) {
          text = `${before}<span class="${escapeHTML(
            span.data.label
          )}">${content}</span>${after}`;
        }
        break;

      default:
        break;
    }
  });

  return text;
};


/*
 * Render a Prismic Rich Text field.
 *
 * Also supports Key Text fields as a fallback.
 */
const renderRichText = (field) => {
  if (!field) return "";

  /*
   * Key Text fallback.
   *
   * New lines entered in a Key Text field become <br>.
   */
  if (typeof field === "string") {
    return `<p>${escapeHTML(field).replace(/\r?\n/g, "<br />")}</p>`;
  }

  /*
   * Rich Text fields should be arrays.
   */
  if (!Array.isArray(field)) {
    return "";
  }

  const output = [];

  field.forEach((block) => {
    if (!block || !block.type) return;

    const text = renderText(block);

    switch (block.type) {
      case "paragraph":
        if (text) {
          output.push(`<p>${text}</p>`);
        }
        break;

      case "heading1":
        if (text) {
          output.push(`<h1>${text}</h1>`);
        }
        break;

      case "heading2":
        if (text) {
          output.push(`<h2>${text}</h2>`);
        }
        break;

      case "heading3":
        if (text) {
          output.push(`<h3>${text}</h3>`);
        }
        break;

      case "heading4":
        if (text) {
          output.push(`<h4>${text}</h4>`);
        }
        break;

      case "heading5":
        if (text) {
          output.push(`<h5>${text}</h5>`);
        }
        break;

      case "heading6":
        if (text) {
          output.push(`<h6>${text}</h6>`);
        }
        break;

      case "preformatted":
        if (text) {
          output.push(`<pre>${text}</pre>`);
        }
        break;

      case "list-item":
        if (text) {
          output.push(`<li>${text}</li>`);
        }
        break;

      case "o-list-item":
        if (text) {
          output.push(`<li>${text}</li>`);
        }
        break;

      case "image":
        if (block.url) {
          const alt = escapeHTML(block.alt || "");

          output.push(
            `<img src="${escapeHTML(block.url)}" alt="${alt}" />`
          );
        }
        break;

      default:
        if (text) {
          output.push(`<p>${text}</p>`);
        }
        break;
    }
  });

  return output.join("");
};


/*
 * ------------------------------------------------------------
 * Prismic data
 * ------------------------------------------------------------
 */

const values = about?.data?.values || [];

const heroTitle = about?.data?.hero_title || "";
const heroSubtitle = about?.data?.hero_subtitle || "";
const heroDescription = about?.data?.hero_description || "";
