    <!-- ========================================= -->
    <!-- PROJECTS + MENU + THEME JS -->
    <!-- ========================================= -->

    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {

        /* ========================================
         * THEME
         * ======================================== */

        let themeMode = localStorage.getItem("themeMode");

        if (themeMode === null) {
          localStorage.setItem("themeMode", "dark");
          themeMode = "dark";
        }

        if (themeMode === "light") {

          document.querySelectorAll(".dark").forEach((element) => {

            element.classList.add("light");
            element.classList.remove("dark");

          });

        }


        const darkToggle =
          document.querySelector(".dark-toggle");

        const lightToggle =
          document.querySelector(".light-toggle");


        /* ========================================
         * DARK MODE
         * ======================================== */

        darkToggle?.addEventListener("click", function () {

          document.querySelectorAll(".light").forEach((element) => {

            element.classList.add("dark");
            element.classList.remove("light");

          });

          localStorage.setItem("themeMode", "dark");

        });


        /* ========================================
         * LIGHT MODE
         * ======================================== */

        lightToggle?.addEventListener("click", function () {

          document.querySelectorAll(".dark").forEach((element) => {

            element.classList.add("light");
            element.classList.remove("dark");

          });

          localStorage.setItem("themeMode", "light");

        });


        /* ========================================
         * MENU
         * ======================================== */

        const menuButton =
          document.querySelector(".menu-button");


        menuButton?.addEventListener("click", function (event) {

          event.preventDefault();

          document.body.classList.toggle("no-scroll");

        });


        /* ========================================
         * PROJECT FILTER
         * ======================================== */

        const filterLinks =
          document.querySelectorAll(".link.projects");


        const projectItems =
          document.querySelectorAll(
            ".collection-item.w-dyn-item"
          );


        const emptyState =
          document.querySelector(".w-dyn-empty");


        function filterProjects(filter) {

          let visibleProjects = 0;


          projectItems.forEach((item) => {

            const project =
              item.querySelector(".div-block-50");

            if (!project) return;


            const tags =
              project.getAttribute("data-type") || "";


            const tagList =
              tags.split(" ").filter(Boolean);


            const matches =
              filter === "all" ||
              tagList.includes(filter);


            if (matches) {

              item.style.display = "block";

              project.style.display = "flex";
              project.style.marginTop = "0px";
              project.style.opacity = "100";

              visibleProjects++;

            } else {

              project.style.opacity = "0";

              setTimeout(() => {

                project.style.display = "none";
                item.style.display = "none";

              }, 300);

            }

          });


          /* EMPTY STATE */

          if (emptyState) {

            emptyState.style.display =
              visibleProjects === 0
                ? "block"
                : "none";

          }


          /* ACTIVE FILTER */

          filterLinks.forEach((link) => {

            link.classList.remove("active");

          });


          const activeLink =
            document.querySelector(
              `.link.projects[data-filter="${filter}"]`
            );


          activeLink?.classList.add("active");

        }


        filterLinks.forEach((link) => {

          link.addEventListener("click", function (event) {

            event.preventDefault();

            const filter =
              this.getAttribute("data-filter");

            filterProjects(filter);

          });

        });


        /* ========================================
         * URL FILTER
         * ======================================== */

        const params =
          new URLSearchParams(window.location.search);


        const urlFilter =
          params.get("project-type");


        if (
          urlFilter &&
          document.querySelector(
            `.link.projects[data-filter="${urlFilter}"]`
          )
        ) {

          filterProjects(urlFilter);

        }


        /* ========================================
         * INITIAL SCROLL
         * ======================================== */

        setTimeout(() => {

          window.scrollTo(0, 0);

        }, 1000);


        /* ========================================
         * PRELOADER CLEANUP
         * ======================================== */

        setTimeout(() => {

          document.body.classList.remove("no-scroll");

        }, 2250);

      });
    </script>

