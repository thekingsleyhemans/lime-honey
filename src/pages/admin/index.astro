---
export const prerender = false;

const AUTH_COOKIE = "admin_session";

const session = Astro.cookies.get(AUTH_COOKIE);

if (session?.value !== "authenticated") {
  return Astro.redirect("/login");
}

interface Project {
  title: string;
  slug: string;
  category: string;
  year: number;
  description: string;
}

const projects: Project[] = [
  {
    title: "Melanin Medics",
    slug: "melanin-medics",
    category: "Brand Identity",
    year: 2025,
    description: "",
  },
  {
    title: "Complete Farmer",
    slug: "complete-farmer",
    category: "Web Design",
    year: 2025,
    description: "",
  },
  {
    title: "Ako Adjei Park",
    slug: "ako-adjei-park",
    category: "Editorial",
    year: 2026,
    description: "",
  },
  {
    title: "Uncontained",
    slug: "uncontained",
    category: "Brand Identity",
    year: 2026,
    description: "",
  },
  {
    title: "Nectar & Co",
    slug: "nectar-and-co",
    category: "Web Design",
    year: 2025,
    description: "",
  },
  {
    title: "Field Notes",
    slug: "field-notes",
    category: "Editorial",
    year: 2025,
    description: "",
  },
  {
    title: "Harmattan",
    slug: "harmattan",
    category: "Brand Identity",
    year: 2026,
    description: "",
  },
  {
    title: "Osu Market",
    slug: "osu-market",
    category: "Web Design",
    year: 2025,
    description: "",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Admin · Lime &amp; Honey</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main class="admin">
      <header class="admin__header">
        <h1 class="admin__title">Welcome, Admin</h1>

        <div class="admin__search">
          <input
            id="project-search"
            type="text"
            placeholder="Search projects"
            aria-label="Search projects"
          />
        </div>
      </header>

      <section class="grid" id="project-grid" aria-label="Projects">
        {
          projects.map((project) => (
            <article
              class="card"
              data-title={project.title.toLowerCase()}
            >
              <div class="card__thumb" aria-hidden="true"></div>

              <div class="card__row">
                <span class="card__title">{project.title}</span>

                <button
                  class="card__menu-btn"
                  type="button"
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-label={`Actions for ${project.title}`}
                  data-slug={project.slug}
                >
                  <svg
                    width="4"
                    height="18"
                    viewBox="0 0 4 18"
                    fill="none"
                    aria-hidden="true"
                  >
                    <circle cx="2" cy="2" r="2" fill="currentColor" />
                    <circle cx="2" cy="9" r="2" fill="currentColor" />
                    <circle cx="2" cy="16" r="2" fill="currentColor" />
                  </svg>
                </button>

                <div class="card__dropdown" role="menu">
                  <button type="button" role="menuitem">
                    Edit
                  </button>

                  <button
                    type="button"
                    role="menuitem"
                    class="danger"
                  >
                    Delete
                  </button>
                </div>
              </div>
            </article>
          ))
        }
      </section>

      <button class="fab" id="add-project-btn" type="button">
        <svg
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          aria-hidden="true"
        >
          <circle
            cx="9"
            cy="9"
            r="8"
            stroke="currentColor"
            stroke-width="1.4"
          />

          <path
            d="M9 5.5V12.5M5.5 9H12.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
          />
        </svg>

        Add New Project
      </button>
    </main>

    <!-- ADD PROJECT MODAL -->

    <div class="modal-backdrop" id="modal-backdrop" hidden>
      <div
        class="modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-heading"
      >
        <div class="modal__head">
          <h2 id="modal-heading">Add New Project</h2>

          <button
            class="modal__close"
            id="modal-close"
            type="button"
            aria-label="Close"
          >
            ×
          </button>
        </div>

        <form id="project-form" class="modal__form">
          <label>
            Title

            <input
              type="text"
              name="title"
              required
            />
          </label>

          <label>
            Slug

            <span class="hint">
              (auto-generated from title if left blank)
            </span>

            <input
              type="text"
              name="slug"
              placeholder="auto"
            />
          </label>

          <label>
            Category

            <input
              type="text"
              name="category"
              required
            />
          </label>

          <label>
            Year

            <input
              type="number"
              name="year"
              min="2000"
              max="2100"
              required
            />
          </label>

          <label>
            Description

            <textarea
              name="description"
              rows="4"
            ></textarea>
          </label>

          <div class="modal__actions">
            <button
              type="button"
              class="btn btn--ghost"
              id="modal-cancel"
            >
              Cancel
            </button>

            <button
              type="submit"
              class="btn btn--primary"
            >
              Save Project
            </button>
          </div>
        </form>
      </div>
    </div>
  </body>

  <script>
    const search =
      document.getElementById("project-search") as HTMLInputElement;

    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(".card")
    );

    search?.addEventListener("input", () => {
      const q = search.value.trim().toLowerCase();

      cards.forEach((card) => {
        const match = card.dataset.title?.includes(q);

        card.dataset.hidden = match ? "false" : "true";
      });
    });

    document
      .querySelectorAll<HTMLButtonElement>(".card__menu-btn")
      .forEach((btn) => {
        btn.addEventListener("click", (event) => {
          event.stopPropagation();

          const dropdown =
            btn.nextElementSibling as HTMLElement;

          const isOpen =
            dropdown.classList.contains("open");

          document
            .querySelectorAll(".card__dropdown.open")
            .forEach((menu) => {
              menu.classList.remove("open");
            });

          document
            .querySelectorAll(".card__menu-btn")
            .forEach((menuButton) => {
              menuButton.setAttribute(
                "aria-expanded",
                "false"
              );
            });

          if (!isOpen) {
            dropdown.classList.add("open");

            btn.setAttribute(
              "aria-expanded",
              "true"
            );
          }
        });
      });

    document.addEventListener("click", () => {
      document
        .querySelectorAll(".card__dropdown.open")
        .forEach((dropdown) => {
          dropdown.classList.remove("open");
        });

      document
        .querySelectorAll(".card__menu-btn")
        .forEach((button) => {
          button.setAttribute(
            "aria-expanded",
            "false"
          );
        });
    });

    const backdrop =
      document.getElementById(
        "modal-backdrop"
      ) as HTMLElement;

    const openBtn =
      document.getElementById(
        "add-project-btn"
      );

    const closeBtn =
      document.getElementById(
        "modal-close"
      );

    const cancelBtn =
      document.getElementById(
        "modal-cancel"
      );

    const form =
      document.getElementById(
        "project-form"
      ) as HTMLFormElement;

    function openModal() {
      backdrop.hidden = false;
    }

    function closeModal() {
      backdrop.hidden = true;
      form.reset();
    }

    openBtn?.addEventListener(
      "click",
      openModal
    );

    closeBtn?.addEventListener(
      "click",
      closeModal
    );

    cancelBtn?.addEventListener(
      "click",
      closeModal
    );

    backdrop?.addEventListener(
      "click",
      (event) => {
        if (event.target === backdrop) {
          closeModal();
        }
      }
    );

    form?.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();

        console.log(
          "Project form submitted:",
          Object.fromEntries(
            new FormData(form)
          )
        );

        closeModal();
      }
    );
  </script>

  <style>
    :root {
      --bg: #1c1a1a;
      --bg-card: #d9d9d9;
      --accent: #eaa50c;
      --accent-text: #1c1a1a;
      --text: #f5f5f3;
      --text-dim: #a8a5a1;

      --radius-lg: 28px;
      --radius-md: 14px;

      --font-display: "Poppins", sans-serif;
      --font-body: "Inter", sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
    }

    .admin {
      max-width: 1440px;
      margin: 0 auto;
      padding: 64px 32px 140px;
    }

    .admin__header {
      text-align: center;
      margin-bottom: 64px;
    }

    .admin__title {
      font-family: var(--font-display);
      font-weight: 600;
      color: var(--accent);
      font-size: clamp(2.5rem, 5vw, 3.75rem);
      margin: 0 0 32px;
      letter-spacing: -0.01em;
    }

    .admin__search input {
      width: min(480px, 90vw);
      border: none;
      border-radius: 999px;
      background: var(--accent);
      color: var(--accent-text);
      font-family: var(--font-body);
      font-weight: 500;
      font-size: 1rem;
      padding: 14px 24px;
      outline-offset: 3px;
    }

    .admin__search input::placeholder {
      color: rgba(28, 26, 26, 0.65);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
    }

    .card {
      position: relative;
    }

    .card__thumb {
      background: var(--bg-card);
      border-radius: var(--radius-lg);
      aspect-ratio: 1 / 1;
      width: 100%;
    }

    .card__row {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 18px;
    }

    .card__title {
      font-family: var(--font-body);
      font-weight: 500;
      font-size: 1.1rem;
    }

    .card__menu-btn {
      background: none;
      border: none;
      color: var(--text-dim);
      cursor: pointer;
      padding: 8px;
      line-height: 0;
    }

    .card__dropdown {
      display: none;
      position: absolute;
      right: 0;
      top: calc(100% + 6px);
      background: #262323;
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
      z-index: 5;
      min-width: 140px;
    }

    .card__dropdown.open {
      display: block;
    }

    .card__dropdown button {
      display: block;
      width: 100%;
      text-align: left;
      background: none;
      border: none;
      color: var(--text);
      font-family: var(--font-body);
      font-size: 0.95rem;
      padding: 12px 16px;
      cursor: pointer;
    }

    .card__dropdown button:hover {
      background: rgba(255, 255, 255, 0.06);
    }

    .card__dropdown button.danger {
      color: #e2685a;
    }

    .card[data-hidden="true"] {
      display: none;
    }

    .fab {
      position: fixed;
      left: 50%;
      bottom: 36px;
      transform: translateX(-50%);
      background: var(--accent);
      color: var(--accent-text);
      border: none;
      border-radius: 999px;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 1rem;
      padding: 16px 28px;
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 20;
      padding: 24px;
    }

    .modal-backdrop[hidden] {
      display: none;
    }

    .modal {
      background: #262323;
      border-radius: var(--radius-lg);
      width: min(480px, 100%);
      padding: 28px;
    }

    .modal__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .modal__head h2 {
      font-family: var(--font-display);
      font-weight: 600;
      color: var(--accent);
      margin: 0;
      font-size: 1.4rem;
    }

    .modal__close {
      background: none;
      border: none;
      color: var(--text-dim);
      font-size: 1.6rem;
      line-height: 1;
      cursor: pointer;
    }

    .modal__form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .modal__form label {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 0.9rem;
      color: var(--text-dim);
    }

    .modal__form .hint {
      font-size: 0.78rem;
    }

    .modal__form input,
    .modal__form textarea {
      background: #1c1a1a;
      border: 1px solid #3a3636;
      border-radius: var(--radius-md);
      color: var(--text);
      font-family: var(--font-body);
      font-size: 0.95rem;
      padding: 10px 14px;
      resize: vertical;
    }

    .modal__form input:focus,
    .modal__form textarea:focus {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .modal__actions {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      margin-top: 8px;
    }

    .btn {
      border: none;
      border-radius: 999px;
      padding: 10px 22px;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
    }

    .btn--ghost {
      background: transparent;
      color: var(--text-dim);
    }

    .btn--primary {
      background: var(--accent);
      color: var(--accent-text);
    }

    @media (max-width: 1100px) {
      .grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (max-width: 760px) {
      .grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 480px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</html>